{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)": "<rootDir>/../src/$1",
    "@common/(.*)": ["<rootDir>/../src/common/$1"],
    "@core/(.*)": ["<rootDir>/../src/core/$1"]
  },
  "globalTeardown": "./jest/jest.global-teardown.js"
}
