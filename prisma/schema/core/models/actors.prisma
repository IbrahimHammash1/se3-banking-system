model Actor {
  id         String  @id @default(uuid())
  fullName   String
  email      String  @unique()
  phone      String  @unique()
  password   String
  sessions  Session[]
  accountStatus         AccountStatus  @default(NOT_ACTIVE)
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
