model AuditLog {
    id        String  @id @default(uuid())
    userId    String?
    userActor Actor?  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    url       String
    method    String
    ip        String?
    platform  String?
    userAgent String?
    duration  String?

    params     Json?
    query      Json?
    body       Json?
    response   Json?
    statusCode Int

    errorMessage String?
    errorStack   String?

    createdAt DateTime @default(now()) @db.Timestamptz(6)
}
