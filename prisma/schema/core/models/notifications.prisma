model Notification {
    id      String              @id @default(uuid())
    isSeen  Boolean             @default(false)
    isRead  Boolean             @default(false)
    purpose NotificationPurpose
    payload Json
    type    NotificationType    @default(SYSTEM)

    senderId String?
    sender   Actor?  @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    receiverId String
    receiver   Actor  @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    createdAt DateTime @default(now()) @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

enum NotificationPurpose {
    COMPLAINTS_MODIFICATION_REQUEST
    COMPLAINTS_STATUS_CHANGED
}
