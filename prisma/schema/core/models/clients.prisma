model Client {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique()
  phone     String   @unique()
  address   String
  dob       DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  accounts            Account[]
  supportTickets      SupportTicket[]
  scheduledTransactions ScheduledTransaction[]
  notifications       Notification[]

  @@index([email])
  @@index([phone])
}
